# Copy to server/.env (gitignored) and fill in. `npm run dev` loads it; without it the server runs
# normally with the write-up off.

# Anthropic API key for the weekly write-up. Use a dedicated key from a Console workspace with a monthly
# spend limit (docs/llm-weekly-writeup.md, section 4). Server only: never put it in the client, and
# never give it a VITE_ prefix (Vite builds those into the public JavaScript).
ANTHROPIC_API_KEY=

# Generate the write-up on startup and at 4 am / 12 pm / 8 pm. Off unless exactly "true", so a dev
# server never calls the model unless you're working on this feature.
WRITEUP_ENABLED=false
